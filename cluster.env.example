# GLM-5.3-Flash NVFP4 / vLLM TP=2 / node2 = head (rank 0), node1 = worker (rank 1)
# Loaded with `docker compose --env-file cluster.env` on both nodes and sourced by scripts/.
# No secrets here. Dot-less filename on purpose (visible in listings; compose reads it via --env-file).

# --- image / model ---
# Day-1 image is tonyd2wild v11 (day-0 base + sm121 patch chain + DFlash port). The STOCK day-0 image
# cannot boot this model on sm_121 at all: the DSA sparse indexer cache path always uses the fp8_ds_mla
# layout and asserts `pe_dim must be 64` on this NoPE model regardless of --kv-cache-dtype
# (smoke #2-#4, 2026-09-01; matches Libertai's finding). Stock stays below for reference.
IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2
IMAGE_DIGEST_EXPECTED=sha256:4def0ef644cb2e9814136dcffd5e385e21bc594f48f3b292234051904abe85a6  # ghcr 2026-08-30 (tonyd2wild README)
IMAGE_ID_EXPECTED=sha256:35c6f70ffcba62fd67d7b9d4b4e8300ad177201792ce9cdb1ea18fd449bc23b6  # verified on both nodes 2026-09-01
IMAGE_STOCK=vllm/vllm-openai:glm53-flash-arm64-cu130  # Id d42649063a2b… (vllm 0.1.dev20051+g487ecf187, torch 2.13.0+cu130, flashinfer 0.6.17, NCCL 2.29.7) — boots the engine but dies at warmup on this model
MODEL_DIR=/models/GLM-5.3-Flash-NVFP4   # container path; host ~/models is mounted read-only
MODEL_REPO=RedHatAI/GLM-5.3-Flash-NVFP4
MODEL_REVISION=36c184c6cda000a481711306df5adde42f63321a  # 2026-08-28, compressed-tensors, 21 files / 184.3 GiB
# The initial release used LibertAIDAI/GLM-5.3-Flash-NVFP4 rev caca4e6a (ModelOpt weight-only). That checkpoint
# intermittently breaks CJK multi-byte characters (U+FFFD ~2 per 10K chars of Japanese) — docs/pitfalls.md #9.
# RedHatAI is a drop-in swap (same model, same tokenizer, same flags) and measured 0 in ~78K chars.
SERVED_MODEL_NAME=glm-5.3-flash-nvfp4

# --- hosts (Mac-side ssh aliases and QSFP addresses) ---
HEAD_HOST=node2            # ssh alias (from your Mac) of the head node
WORKER_HOST=node1          # ssh alias of the worker node
HEAD_IP=192.168.200.14
WORKER_IP=192.168.200.13
MASTER_ADDR=192.168.200.14
MASTER_PORT=25000
PORT=8888
VLLM_HOST=127.0.0.1         # loopback only; put your own reverse proxy / auth in front if you expose it

# --- fabric (the 3-variable set + IB) ---
NCCL_IB_HCA=rocep1s0f1      # lowercase p only (the uppercase-P device has no IPv4 GID)
NCCL_SOCKET_IFNAME=enp1s0f1np1
UCX_NET_DEVICES=enp1s0f1np1
NCCL_IB_GID_INDEX=3         # measured: index 3 = RoCE v2 + ::ffff:192.168.200.x on both nodes
NCCL_DEBUG=INFO             # first boots only; set WARN once stable
VLLM_ENGINE_READY_TIMEOUT_S=3600

# --- vLLM flags: defaults are MTP k=3 (262K / 2 slots, bundled head, commercial-safe), measured 2026-09-02 — see README "Just use this" ---
MAX_MODEL_LEN=262144            # context length does not move speed (262K vs 65K: same tok/s); 8 slots still fit at 262K
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=4096     # 8192 reported to OOM the GB10 driver
BLOCK_SIZE=2304                 # page size the fp8 paged MQA expects — without it output corrupts with no error (docs/pitfalls.md §10)
# KV pool: empty = profiler-sized. On this checkpoint that is 7.48 GiB = 1,151,844 tokens = 4.39 full-262K streams.
# (LibertAI-era pins were 3221225472 with DFlash2 / 9663676416 with MTP.) Keep the empty value comment-free (pitfalls #2).
KV_CACHE_MEMORY_BYTES=
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_DTYPE=fp8_e4m3          # tonyd2wild v8/v11 value (patched KV kernels). auto (bf16) cannot even boot at 262K on this checkpoint: one 262K request needs 3.62 GiB vs 3.54 GiB available
ENFORCE_EAGER=1                 # 1 = --enforce-eager (measured); 0 = CUDA graphs (not measured on this pair)
MOE_BACKEND=marlin              # marlin (measured). flashinfer_cutlass froze BOTH hosts at util 0.85 — never run it unattended (docs/pitfalls.md §3)
MTP_NUM_TOKENS=3                # num_speculative_tokens: 3 = fastest single-stream on this checkpoint (26.5 tok/s); 4 for the 8-slot shared profile; 7 with DFlash2; 0 = off
SPEC_METHOD=mtp                 # mtp (bundled MTP head, commercial-safe — default) | dflash (incoai drafter, CC-BY-NC-ND; best effective code-gen tok/s)
# SPEC_MODEL: e.g. /models/GLM-5.3-Flash-DFlash2 (container path; host ~/models). NOTE: compose's env-file
# parser does NOT strip an inline comment after an EMPTY value (it became the value and killed the first
# smoke, 2026-09-01 02:35) — keep empty-valued lines comment-free.
# SPEC_MODEL: set /models/GLM-5.3-Flash-DFlash2 together with SPEC_METHOD=dflash MTP_NUM_TOKENS=7.
SPEC_MODEL=
FLASHINFER_AUTOTUNE=1           # 0 = --kernel-config '{"enable_cutedsl_warmup":false,"enable_flashinfer_autotune":false}' (shorter boot, Ama5u)
TOOL_CALL_PARSER=glm47          # `glm` fails silently
REASONING_PARSER=deepseek_r1    # model card's vLLM value; try glm45 if <think> leaks into content
VLLM_EXTRA_ARGS=

# --- images (2026-09-02) ---
# 1 = --language-model-only (text only; every number in docs/measurements.md §0-4). 0 = also load the vision
# tower (1.05 GiB BF16 per rank; the quantization recipe leaves model.visual.* alone) and append VISION_ARGS.
# The RedHat checkpoint's chat_template.jinja already emits <|begin_of_image|><|image|><|end_of_image|>; the
# ViT picks FLASH_ATTN on GB10. Warmup profiles limit x max_image_tokens images and that memory comes out of
# the KV pool (8 slots: 4.29 GiB text-only at 262K vs 3.31 GiB with images at 131K), so pair it with a shorter
# MAX_MODEL_LEN or fewer slots. Single quotes on purpose: bash `source` and compose's env-file parser both
# yield the bare JSON. Measured (docs/measurements.md §5): chart 4/4, OCR CER 0.0, PPE fail — same 2/3 as the
# author's single-Spark GGUF run, at 2.5 s / 4.4 s per image.
LANGUAGE_MODEL_ONLY=1
VISION_ARGS='--limit-mm-per-prompt {"image":4} --mm-processor-kwargs {"max_image_tokens":2048}'

# UTF-8 guard (patches/utf8_guard_lp.py): only needed on the LibertAI/ModelOpt checkpoint (pitfalls #9). Opt-in; vLLM refuses it with speculative decoding.
LOGITS_PROCESSORS=
